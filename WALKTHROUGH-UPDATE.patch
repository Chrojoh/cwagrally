+import assert from 'node:assert/strict';
+import {openWalkthrough} from '../src/ui/walkthrough.js';
+let callback,removed=false,draws=0,disconnected=false;
+const context=new Proxy({}, {get(target,key){if(key in target)return target[key];return (...args)=>{if(key==='drawImage')draws++;};},set(target,key,value){target[key]=value;return true;}});
+const elements=new Map();
+function element(selector){if(!elements.has(selector))elements.set(selector,{value:selector==='[data-speed]'?'3':selector==='[data-view]'?'follow':'0',hidden:false,textContent:'',attrs:{},getAttribute(k){return this.attrs[k];},set src(v){this.attrs.src=v;},getContext(){return context;},getBoundingClientRect(){return {width:900,height:440};}});return elements.get(selector);}
+let onClose;
+const dialog={querySelector:element,showModal(){},close(){onClose();},addEventListener(type,fn){if(type==='close')onClose=fn;},remove(){removed=true;}};
+globalThis.document={createElement(){return dialog;},body:{append(){}}};
+globalThis.Image=class {complete=true;naturalWidth=100;};
+globalThis.ResizeObserver=class {observe(){}disconnect(){disconnected=true;}};
+globalThis.requestAnimationFrame=fn=>{callback=fn;return 1;};
+globalThis.cancelAnimationFrame=()=>{callback=null;};
+const course={ring:{width:30,height:30},nodes:[{kind:'start',x:5,y:5},{kind:'station',x:15,y:5,signId:'S1'},{kind:'finish',x:15,y:15}],noGoZones:[]};
+openWalkthrough(course,{id:'cwags',signs:{S1:{id:'S1',name:'Right Turn',image:'Signs/S1.png'}}});
+assert.match(element('[data-title]').textContent,/Start/);
+element('[data-next]').onclick();
+assert.match(element('[data-title]').textContent,/Station 1/);
+assert.equal(Number(element('[data-progress]').value),10);
+element('[data-view]').value='overview';element('[data-view]').onchange();
+element('[data-pause-stations]').checked=true;
+element('[data-restart]').onclick();element('[data-play]').onclick();
+for(let i=0;i<120;i++)callback(1000+i*100);
+assert.equal(Number(element('[data-progress]').value),10,'playback pauses at next station');
+assert.equal(element('[data-play]').textContent,'Play');
+element('[data-pause-stations]').checked=false;
+element('[data-play]').onclick();
+for(let i=0;i<150;i++)callback(14000+i*50);
+assert.equal(Number(element('[data-progress]').value),20,'continuous playback passes signs and stops at finish');
+assert.ok(draws>0,'loaded sign artwork is drawn');
