diff --git a/src/core/exercise-motion.js b/src/core/exercise-motion.js
new file mode 100644
index 0000000..0186437
--- /dev/null
+++ b/src/core/exercise-motion.js
@@ -0,0 +1,48 @@
+// Illustrative handler motion, sourced from C-WAGS Starter.2021-web.pdf.
+// Distances/radii/timing are preview choices, not mandated performance dimensions.
+const rad=degrees=>degrees*Math.PI/180;
+const smooth=t=>t*t*(3-2*t);
+export function exerciseScript(packId,signId) {
+  if(packId!=='cwags')return null;
+  const turn=degrees=>({type:'turn',degrees,duration:Math.max(1.5,Math.abs(degrees)/65)});
+  const pivot=degrees=>({type:'pivot',degrees,duration:Math.abs(degrees)/60});
+  const hold={type:'hold',duration:.9};
+  const scripts={
+    S1:[turn(90)],S2:[turn(-90)],S3:[turn(270)],S4:[turn(-270)],
+    S5:[hold,pivot(90),hold],S6:[hold,pivot(90)],
+    S7:[turn(180)],S8:[turn(-180)],
+    S13:[hold,{type:'move',forward:1.5,duration:.7},hold,{type:'move',forward:3,duration:1.2},hold,{type:'move',forward:4.5,duration:1.7},hold],
+    S17:[hold,{type:'move',forward:-1.5,duration:.7},hold,{type:'move',forward:-3,duration:1.2},hold,{type:'move',forward:-4.5,duration:1.7},hold],
+    S18:[{type:'pace',pace:.55,duration:.3}],S19:[{type:'pace',pace:1.5,duration:.3}],S20:[{type:'pace',pace:1,duration:.3}],
+    S21:[{type:'move',forward:1.5,right:1.5,duration:1}],
+    S22:[pivot(90),{type:'move',forward:3.75,duration:1.5},pivot(-90)],
+    S23:[turn(360)],S24:[turn(-360)],S30:[hold],
+    S31:[pivot(-90),{type:'move',forward:3.75,duration:1.5},pivot(90)],
+    S32:[turn(45)],S33:[turn(-45)]
+  };
+  const steps=scripts[signId];
+  return steps?{steps,duration:steps.reduce((sum,s)=>sum+s.duration,0),pace:steps.find(s=>s.type==='pace')?.pace}:null;
+}
+export function sampleExercise(script,time) {
+  let x=0,y=0,heading=0,remaining=Math.max(0,time);
+  for(const step of script.steps){
+    const t=smooth(Math.min(1,remaining/step.duration));
+    const f={x:Math.cos(heading),y:Math.sin(heading)},r={x:-f.y,y:f.x};
+    if(step.type==='turn'){
+      const angle=rad(Math.abs(step.degrees))*t,dir=Math.sign(step.degrees),radius=1.5;
+      const forward=radius*Math.sin(angle),right=dir*radius*(1-Math.cos(angle));
+      x+=f.x*forward+r.x*right;y+=f.y*forward+r.y*right;heading+=dir*angle;
+    }else if(step.type==='pivot')heading+=rad(step.degrees)*t;
+    else if(step.type==='move'){
+      x+=(f.x*(step.forward||0)+r.x*(step.right||0))*t;
+      y+=(f.y*(step.forward||0)+r.y*(step.right||0))*t;
+    }
+    if(remaining<step.duration)break;
+    remaining-=step.duration;
+  }
+  return {x,y,heading,done:time>=script.duration};
+}
+export function exerciseWorldPose(origin,local) {
+  const c=Math.cos(origin.heading),s=Math.sin(origin.heading);
+  return {x:origin.x+local.x*c-local.y*s,y:origin.y+local.x*s+local.y*c,heading:origin.heading+local.heading};
+}
diff --git a/src/core/ring-scene.js b/src/core/ring-scene.js
new file mode 100644
index 0000000..9d78804
--- /dev/null
+++ b/src/core/ring-scene.js
@@ -0,0 +1,23 @@
+// Preview scenery only; this does not alter the course or its boundaries.
+export function ringFence(ring,start={x:ring.width/2,y:0}) {
+  const {width:w,height:h}=ring;
+  const sides=[{a:[0,0],b:[w,0],distance:Math.abs(start.y),along:start.x},
+    {a:[w,0],b:[w,h],distance:Math.abs(w-start.x),along:start.y},
+    {a:[0,h],b:[w,h],distance:Math.abs(h-start.y),along:start.x},
+    {a:[0,0],b:[0,h],distance:Math.abs(start.x),along:start.y}];
+  const gate=sides.reduce((a,b)=>a.distance<=b.distance?a:b);
+  const panels=[];
+  for(const side of sides){
+    const length=Math.hypot(side.b[0]-side.a[0],side.b[1]-side.a[1]);
+    const center=Math.max(3,Math.min(length-3,side.along));
+    const ranges=side===gate?[[0,center-2.5],[center+2.5,length]]:[[0,length]];
+    for(const [from,to] of ranges){
+      const count=Math.ceil((to-from)/6);
+      for(let i=0;i<count;i++){
+        const point=t=>[side.a[0]+(side.b[0]-side.a[0])*t/length,side.a[1]+(side.b[1]-side.a[1])*t/length];
+        panels.push({a:point(from+(to-from)*i/count),b:point(from+(to-from)*(i+1)/count)});
+      }
+    }
+  }
+  return panels;
+}
diff --git a/src/core/walkthrough.js b/src/core/walkthrough.js
new file mode 100644
index 0000000..fca3422
--- /dev/null
+++ b/src/core/walkthrough.js
@@ -0,0 +1,34 @@
+// Route preview only: movements within individual exercises are not simulated.
+export function buildWalkthrough(course) {
+  let distance=0, ordinal=0;
+  const stops=[];
+  const nodes=course.nodes.map((node,index)=>{
+    if(index) distance+=Math.hypot(node.x-course.nodes[index-1].x,node.y-course.nodes[index-1].y);
+    const entry={...node,distance,ordinal:node.kind==='station'?++ordinal:null};
+    if(['station','start','finish'].includes(node.kind)) stops.push(entry);
+    return entry;
+  });
+  return {nodes,stops,length:distance};
+}
+export function sampleWalkthrough(route,distance) {
+  const d=Math.max(0,Math.min(route.length,Number(distance)||0));
+  let i=route.nodes.findIndex((n,index)=>index>0&&n.distance>d);
+  if(i<0) i=route.nodes.length-1;
+  const a=route.nodes[Math.max(0,i-1)],b=route.nodes[i]||a;
+  if(!a) return null;
+  const span=b.distance-a.distance,t=span>0?(d-a.distance)/span:0;
+  return {x:a.x+(b.x-a.x)*t,y:a.y+(b.y-a.y)*t,heading:Math.atan2(b.y-a.y,b.x-a.x),distance:d,next:route.stops.find(n=>n.distance>d+0.01)||route.stops.at(-1)};
+}
+
+// Blend the viewing direction around corners without rounding the route itself.
+export function walkthroughHeading(route,distance,lookAhead=2) {
+  const before=sampleWalkthrough(route,distance-lookAhead);
+  const after=sampleWalkthrough(route,distance+lookAhead);
+  if(!before||!after)return 0;
+  const dx=after.x-before.x,dy=after.y-before.y;
+  return Math.hypot(dx,dy)>0.001?Math.atan2(dy,dx):sampleWalkthrough(route,distance).heading;
+}
+export function easeHeading(current,target,dt) {
+  const delta=Math.atan2(Math.sin(target-current),Math.cos(target-current));
+  return current+delta*(1-Math.exp(-Math.max(0,dt)*7));
+}
diff --git a/src/core/worker-client.js b/src/core/worker-client.js
new file mode 100644
index 0000000..890f144
--- /dev/null
+++ b/src/core/worker-client.js
@@ -0,0 +1,54 @@
+// One active search at a time. Terminating the worker also stops CPU work;
+// ignoring a stale response alone would leave it blocking the next search.
+export class GenerationClient {
+  constructor(createWorker) {
+    this.createWorker = createWorker;
+    this.worker = null;
+    this.pending = null;
+    this.requestId = 0;
+  }
+
+  cancel() {
+    if (!this.pending) return;
+    const pending = this.pending;
+    this.pending = null;
+    this.worker?.terminate();
+    this.worker = null;
+    const error = new Error('Course search cancelled.');
+    error.name = 'AbortError';
+    pending.reject(error);
+  }
+
+  run(packId, options, operation = 'generate') {
+    this.cancel();
+    if (!this.worker) {
+      const worker = this.createWorker();
+      this.worker = worker;
+      worker.onmessage = ({data}) => {
+        if (this.worker !== worker || data.id !== this.pending?.id) return;
+        const pending = this.pending;
+        this.pending = null;
+        data.error ? pending.reject(new Error(data.error)) : pending.resolve(data.result ?? data.course);
+      };
+      worker.onerror = () => {
+        if (this.worker !== worker) return;
+        const pending = this.pending;
+        this.pending = null;
+        worker.terminate();
+        this.worker = null;
+        pending?.reject(new Error('Course generation could not start. Serve this folder over HTTP and try again.'));
+      };
+    }
+    const id = ++this.requestId;
+    return new Promise((resolve, reject) => {
+      this.pending = {id, resolve, reject};
+      try { this.worker.postMessage({id, packId, options, operation}); }
+      catch (error) {
+        this.pending = null;
+        this.worker.terminate();
+        this.worker = null;
+        reject(error);
+      }
+    });
+  }
+}
